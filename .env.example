# ==============================================================================
# REGRAVA - Environment Configuration
# Tagline: Catch what your diff could break.
# ==============================================================================

# Server Network Settings
REGRAVA_HOST=127.0.0.1
REGRAVA_PORT=8000
REGRAVA_ENV=development

# Session & Security
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
REGRAVA_SECRET_KEY=regrava-dev-secret-key-change-in-production-32bytes
REGRAVA_SESSION_COOKIE_NAME=regrava_session
REGRAVA_SESSION_MAX_AGE_SECONDS=604800

# SQLite Local Database File
REGRAVA_DB_PATH=regrava.db

# Demo Mode (Enabled by default for zero-credential instant testing)
REGRAVA_ALLOW_DEMO_LOGIN=true

# Google OAuth / OpenID Connect (Optional for live Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub App Configuration (Optional for live GitHub App integration)
# Register a GitHub App under Settings -> Developer settings -> GitHub Apps
GITHUB_APP_NAME=regrava-scanner
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Analysis Sandbox Limits
REGRAVA_MAX_FILE_SIZE_BYTES=1048576
REGRAVA_SUBPROCESS_TIMEOUT_SECONDS=20
REGRAVA_MAX_DIFF_FILES=500
